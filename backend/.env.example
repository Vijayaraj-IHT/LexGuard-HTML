# LexGuard Backend Environment Configuration
ENVIRONMENT=development
DEBUG=True

PROJECT_NAME="LexGuard High Court Judicial Repository"
API_V1_STR="/api/v1"
ENABLE_API_DOCS=True

# Phase-1 single-service mode: set SERVE_FRONTEND=True when FastAPI should
# also serve ../frontend from the same origin (recommended on Render).
SERVE_FRONTEND=False
FRONTEND_DIR=../frontend
RUN_MIGRATIONS=False

# Security (change SECRET_KEY in production; never reuse this example value)
SECRET_KEY=lexguard-super-secret-jwt-key-2026-production-ready-32-chars-min
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480
REFRESH_TOKEN_EXPIRE_DAYS=7

# Cookie & CSRF
COOKIE_NAME=lexguard_access_token
COOKIE_SECURE=False
COOKIE_SAMESITE=lax
CSRF_HEADER_NAME=X-CSRF-Token
CSRF_SECRET=lexguard-csrf-protection-secret-key-salt

# Database Connection (PostgreSQL local default; Neon postgresql:// URLs are
# also accepted and normalized to the psycopg2 SQLAlchemy dialect)
DATABASE_URL=postgresql+psycopg2://lexguard:lexguard123@localhost:5432/lexguard
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=1800
# Canonical/restored databases store embeddings as JSON. Enable only for a
# fresh database whose cases.embedding column is native vector(384).
USE_PGVECTOR=False

# Storage (relative paths resolve from backend/)
STORAGE_DIR=./storage/cases

# Optional local ML / hosted LLM behaviour. On free hosting keep the local
# LLM disabled and use deterministic fallbacks.
USE_LOCAL_LLM=False
USE_MOCK_LLM=True
ANTHROPIC_API_KEY=
EMBEDDING_MODEL_NAME=sentence-transformers/all-MiniLM-L6-v2
LEGAL_NER_MODEL_NAME=law-ai/InLegalBERT
